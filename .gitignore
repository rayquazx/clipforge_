# ==============================================================================
# ClipForge — Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# Node.js & Next.js
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
.next/
out/
build/
dist/

# Turborepo / Vercel
.turbo/
.vercel/

# TypeScript declaration cache
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# Python & FastAPI
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.c

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Celery & Background Workers
celerybeat-schedule
celerybeat.pid
*.pid

# ------------------------------------------------------------------------------
# Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.eslintcache
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# Docker & Local Data Volumes
# ------------------------------------------------------------------------------
postgres_data/
redis_data/
minio_data/
data/
*.rdb

# ------------------------------------------------------------------------------
# Media Processing & Temporary Files
# ------------------------------------------------------------------------------
# Video and stream chunks downloaded during clip processing
temp/
tmp/
clips_temp/
downloads/
processed_clips/
*.mp4
*.mkv
*.webm
*.avi
*.ts
*.m3u8
*.wav
*.mp3
*.aac

# ------------------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------------------
logs/
*.log

# ------------------------------------------------------------------------------
# Operating Systems
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.swn
.project
.classpath
.c9/
*.launch
