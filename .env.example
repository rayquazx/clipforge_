# ==============================================================================
# ClipForge — Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
MAX_UPLOAD_SIZE_MB=500

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=clipforge
POSTGRES_DB=clipforge
POSTGRES_PORT=5432

# Async SQLAlchemy connection string (used by FastAPI and Celery)
DATABASE_URL=postgresql+asyncpg://clipforge:clipforge@localhost:5432/clipforge

# ------------------------------------------------------------------------------
# Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3-compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=clipforge
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# External Platform API Keys (Phase 2 Metadata Providers)
# ------------------------------------------------------------------------------
# Twitch Developer Portal: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google Cloud Console (YouTube Data API v3): https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Kick Public API / Streamer API (Optional)
KICK_API_KEY=

# ------------------------------------------------------------------------------
# Speech-to-Text & AI Moment Detection (Phase 3)
# ------------------------------------------------------------------------------
# Whisper model size for faster-whisper: tiny, base, small (default), medium, large-v3
WHISPER_MODEL=small

# Anthropic API Key (Claude 3.5 Sonnet / Haiku for clip titles and reasons)
# If left blank, ClipForge automatically falls back to template-based extraction.
ANTHROPIC_API_KEY=

# Audio processing & chunking limits
AUDIO_CHUNK_MINUTES=10
MAX_VIDEO_DURATION_HOURS=6

# ------------------------------------------------------------------------------
# Frontend (Next.js 14)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
